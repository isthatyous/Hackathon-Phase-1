pipeline {
    agent any

    environment {
        image_name = 'online-shop-image'
    }

    stages {
        stage('Code Checkout') {
            steps {
                git branch: 'feature/feature-branch-1', changelog: false, poll: false, url: 'https://github.com/isthatyous/Hackathon-Phase-1.git'
            }
        }

        stage('SonarQube analysis') {
            steps {
                script {
                    scannerHome = tool 'SonarQube'
                }
                withSonarQubeEnv('SonarQube') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner \
                        -Dsonar.projectKey=online-shop-key \
                        -Dsonar.sources=. \
                        -Dsonar.host.url=http://13.234.38.127:9100 \
                        -Dsonar.login=squ_ad703a4e7804383c5b76d1f9d8eb78f69d0a363c
                    """
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    sh "echo jenkins_${env.BRANCH_NAME}_${env.BUILD_ID}"
                    
                    sh "docker build -t ${image_name}:${env.BUILD_ID} ."
                    
                    withCredentials([usernamePassword(credentialsId: 'DockerHub-Creds', usernameVariable: 'DockerHubusername', passwordVariable: 'DockerHubpassword')]) {
                        sh """
                            echo ${DockerHubpassword} | docker login -u ${DockerHubusername} --password-stdin
                            docker tag ${image_name}:${env.BUILD_ID} ${DockerHubusername}/${image_name}:${env.BUILD_ID}
                        """
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'DockerHub-Creds', usernameVariable: 'DockerHubusername', passwordVariable: 'DockerHubpassword')]) {
                    sh "trivy image ${DockerHubusername}/${image_name}:${env.BUILD_ID}"
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'DockerHub-Creds', usernameVariable: 'DockerHubusername', passwordVariable: 'DockerHubpassword')]) {
                    sh "docker push ${DockerHubusername}/${image_name}:${env.BUILD_ID}"
                }
            }
        }
    }
}
